#Puerto por el que escuchará el servidor
#Por defecto se encuentran mapeados los puertos:
#80     ->    9090
#10001  ->    10001
#...
#10010  ->    10010
Listen 10005

#host virtual (La carpeta debe existir en ./html/)
<VirtualHost *:10005>
        DocumentRoot /var/www/html/nombre_proyecto/
</VirtualHost>
